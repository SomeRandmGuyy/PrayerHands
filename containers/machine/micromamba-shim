#!/usr/bin/env python3
"""Launch adapter for the Gentle Fist Machine.

The application runtime starts a sandbox with the historical command:

    /openhands/micromamba/bin/micromamba run -n openhands poetry run python ...

This image uses the system Python on PATH. The adapter drops that wrapper and
executes the remaining command, so Gentle Fist can launch this machine without
renaming the Python package.
"""

import os
import sys


def main() -> None:
    args = sys.argv[1:]
    if (
        len(args) >= 5
        and args[0] == 'run'
        and args[1] == '-n'
        and args[3] == 'poetry'
        and args[4] == 'run'
    ):
        args = args[5:]
    if not args:
        os.execvp('bash', ['bash'])
    os.execvp(args[0], args)


if __name__ == '__main__':
    main()
