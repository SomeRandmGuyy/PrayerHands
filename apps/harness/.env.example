# Gentle Fist harness. Copy to apps/harness/.env. Never commit real keys.

# Python OpenHands server (this repo). HTTP + Socket.IO stay on that process.
NUXT_PUBLIC_OPENHANDS_BASE_URL=

# Existing Railway webtop. The VM pane embeds this URL. It does not redeploy the service.
NUXT_PUBLIC_RAILWAY_WEBTOP_URL=https://desktop-production-b39d.up.railway.app

# Railway API token for POST /api/railway/spin when execute=true.
# Accepts either an account token or a project token. Leave empty to stay not connected.
# RAILWAY_API_TOKEN=
# RAILWAY_TOKEN=

# Hermes Agent (Nous Research) OpenAI-compatible API server.
# Docs: https://hermes-agent.nousresearch.com/docs/user-guide/features/api-server
# HERMES_API_BASE_URL=http://127.0.0.1:8642
# HERMES_API_SERVER_KEY=

# Prime Agent (Prime Intellect) RPC binary. Absolute path. The harness does not spawn it.
# PRIME_AGENT_BIN=

# Thesys C1 generative UI API. The harness does not call it without a key, and does not
# call it automatically even when a key is present.
# THESYS_API_KEY=
# THESYS_C1_BASE_URL=https://api.thesys.dev/v1/embed

# CopilotKit CoAgents runtime you host (AG-UI). Vue SDK: @copilotkit/vue
# NUXT_PUBLIC_COPILOTKIT_RUNTIME_URL=
